# === Nexoda Booking Bot — настройки ===
# Скопируй этот файл в .env и заполни значения.

# 1) Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# 2) Твой Telegram ID (узнать: напиши боту команду /id). Можно несколько через запятую.
ADMIN_IDS=

# 3) Часовой пояс (для Ташкента оставь как есть)
TIMEZONE=Asia/Tashkent

# 4) Название бизнеса (можно изменить потом в админке)
BUSINESS_NAME=Наш салон
